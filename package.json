{
  "name": "mediawiki-vscode-editor",
  "displayName": "MediaWiki ⇄ VSCode External Editor",
  "description": "Edit MediaWiki pages in VSCode; the browser previews on save and performs the edit",
  "version": "0.4.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onLanguage:mediawiki-wikitext"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mediawikiEditor.push",
        "title": "MediaWiki: 立即推送当前文件预览"
      },
      {
        "command": "mediawikiEditor.status",
        "title": "MediaWiki: 显示连接状态"
      },
      {
        "command": "mediawikiEditor.save",
        "title": "MediaWiki: 通过 InPageEdit 保存当前文件"
      },
      {
        "command": "mediawikiEditor.check",
        "title": "MediaWiki: 重新检查当前文件"
      },
      {
        "command": "mediawikiEditor.addWiki",
        "title": "MediaWiki: 添加 wiki"
      },
      {
        "command": "mediawikiEditor.removeWiki",
        "title": "MediaWiki: 删除 wiki"
      },
      {
        "command": "mediawikiEditor.listWikis",
        "title": "MediaWiki: 列出已添加的 wiki"
      }
    ],
    "configuration": {
      "title": "MediaWiki External Editor",
      "properties": {
        "mediawikiEditor.port": {
          "type": "number",
          "default": 8927,
          "description": "本地 WebSocket 端口，需与用户脚本中的 WS_URL 一致。"
        },
        "mediawikiEditor.tempDir": {
          "type": "string",
          "default": "",
          "description": "源码落盘目录。留空则使用用户缓存目录：$XDG_CACHE_HOME/mediawiki-edit（Linux）、~/Library/Caches/mediawiki-edit（macOS）、%LOCALAPPDATA%\\mediawiki-edit（Windows）。"
        },
        "mediawikiEditor.allowedOrigin": {
          "type": "string",
          "default": "*",
          "description": "允许连接的浏览器来源；`*` 表示不限制，也可填单个 origin（如 https://example.org）。"
        },
        "mediawikiEditor.languageFeatures": {
          "type": "boolean",
          "default": true,
          "description": "为编辑会话启用内建语言功能（诊断、折叠、补全、跳转等）。"
        },
        "mediawikiEditor.diagnosticsWarnings": {
          "type": "boolean",
          "default": false,
          "description": "诊断中是否包含警告；关闭时只显示错误。"
        },
        "mediawikiEditor.diagnosticsDelay": {
          "type": "number",
          "default": 400,
          "description": "停止输入后等待多少毫秒再执行诊断。"
        },
        "mediawikiEditor.diagnosticsMaxLength": {
          "type": "number",
          "default": 100000,
          "description": "超过该字符数的文档不自动诊断、不生成语义高亮；设为 0 表示不限制。"
        },
        "mediawikiEditor.parserConfig": {
          "type": "string",
          "default": "",
          "description": "解析配置 JSON 的绝对路径或相对工作区路径；留空使用内置 vcpedia 配置。"
        }
      }
    },
    "languages": [
      {
        "id": "mediawiki-wikitext",
        "aliases": [
          "MediaWiki Wikitext",
          "Wikitext"
        ],
        "extensions": [
          ".wiki"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mediawiki-wikitext",
        "scopeName": "source.mediawiki",
        "path": "./syntaxes/mediawiki.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "opencc-js": "^1.4.2",
    "wikiparser-node": "^2.1.0",
    "ws": "^8.22.1"
  }
}
