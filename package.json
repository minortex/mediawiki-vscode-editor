{
  "name": "mediawiki-vscode-editor",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.22.0",
  "publisher": "minortex",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:mediawiki-wikitext"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mediawikiEditor.push",
        "title": "%command.push.title%"
      },
      {
        "command": "mediawikiEditor.status",
        "title": "%command.status.title%"
      },
      {
        "command": "mediawikiEditor.save",
        "title": "%command.save.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mediawikiEditor.check",
        "title": "%command.check.title%"
      },
      {
        "command": "mediawikiEditor.removeWiki",
        "title": "%command.removeWiki.title%"
      },
      {
        "command": "mediawikiEditor.listWikis",
        "title": "%command.listWikis.title%"
      },
      {
        "command": "mediawikiEditor.openPage",
        "title": "%command.openPage.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "mediawikiEditor.closeSession",
        "title": "%command.closeSession.title%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mediawikiEditor.restoreDraft",
        "title": "%command.restoreDraft.title%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "mediawikiEditor.port": {
          "type": "number",
          "default": 8927,
          "description": "%config.port.description%"
        },
        "mediawikiEditor.tempDir": {
          "type": "string",
          "default": "",
          "description": "%config.tempDir.description%"
        },
        "mediawikiEditor.allowedOrigin": {
          "type": "string",
          "default": "*",
          "description": "%config.allowedOrigin.description%"
        },
        "mediawikiEditor.languageFeatures": {
          "type": "boolean",
          "default": true,
          "description": "%config.languageFeatures.description%"
        },
        "mediawikiEditor.diagnosticsWarnings": {
          "type": "boolean",
          "default": false,
          "description": "%config.diagnosticsWarnings.description%"
        },
        "mediawikiEditor.diagnosticsDelay": {
          "type": "number",
          "default": 400,
          "description": "%config.diagnosticsDelay.description%"
        },
        "mediawikiEditor.diagnosticsMaxLength": {
          "type": "number",
          "default": 100000,
          "description": "%config.diagnosticsMaxLength.description%"
        },
        "mediawikiEditor.parserConfig": {
          "type": "string",
          "default": "",
          "description": "%config.parserConfig.description%"
        }
      }
    },
    "languages": [
      {
        "id": "mediawiki-wikitext",
        "aliases": [
          "MediaWiki Wikitext",
          "Wikitext"
        ],
        "extensions": [
          ".wiki"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mediawiki-wikitext",
        "scopeName": "source.mediawiki",
        "path": "./syntaxes/mediawiki.tmLanguage.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mediawikiEditor.save",
          "when": "mediawikiEditor.sessionActive",
          "group": "navigation@1"
        },
        {
          "command": "mediawikiEditor.openPage",
          "when": "mediawikiEditor.sessionActive",
          "group": "navigation@2"
        },
        {
          "command": "mediawikiEditor.closeSession",
          "when": "mediawikiEditor.sessionActive",
          "group": "navigation@3"
        }
      ]
    }
  },
  "dependencies": {
    "opencc-js": "^1.4.2",
    "wikiparser-node": "^2.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@inpageedit/core": "^0.19.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vscode-languageserver-types": "^3.18.5"
  },
  "scripts": {
    "compile": "npm run clean && tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test test/*.test.mjs",
    "build:ipe": "npm run typecheck:ipe && vite build --config ipe-plugin/vite.config.ts && node scripts/update-ipe-registry.mjs",
    "typecheck:ipe": "tsc -p ipe-plugin/tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "survey:ast": "npm run compile && node scripts/survey-ast-locate.mjs",
    "package:vsix": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm run compile && npx --yes @vscode/vsce package --out dist/mediawiki-vscode-editor-${npm_package_version}.vsix",
    "publish:ovsx": "npx --yes ovsx publish dist/mediawiki-vscode-editor-${npm_package_version}.vsix --trusted-publishing --skip-duplicate",
    "publish:marketplace": "npx --yes @vscode/vsce publish --oidc --packagePath dist/mediawiki-vscode-editor-${npm_package_version}.vsix --skip-duplicate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minortex/mediawiki-vscode-editor.git"
  },
  "homepage": "https://github.com/minortex/mediawiki-vscode-editor",
  "bugs": {
    "url": "https://github.com/minortex/mediawiki-vscode-editor/issues"
  }
}
