      "author": "minortex",
      "license": "MIT",
      "loader": {
        "kind": "autoload",
        "entry": "loader.js"
      }
    }
  ],
  "maintainers": [
    {
      "name": "minortex"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/minortex/mediawiki-vscode-editor"
  }
}
